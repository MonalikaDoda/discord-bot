<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Dashboard</title>
  <style>
    table { width: 100%; border-collapse: collapse; margin-top: 1rem; }
    th, td { border: 1px solid #ddd; padding: 8px; text-align: left; }
    th { background: #f4f4f4; }
    .small { font-size: 0.9em; color: #555; }
  </style>
</head>
<body>
  <h1>Admin Dashboard</h1>
  <p>You are signed in as an admin. <a href="/logout">Sign out</a></p>

  <div id="loading">Loading logs...</div>
  <table id="logsTable" style="display:none">
    <thead>
      <tr>
        <th>Command</th>
        <th>User ID</th>
        <th>Input Text</th>
        <th>AI Tag / Summary</th>
        <th>Timestamp</th>
        <th>Action Taken</th>
      </tr>
    </thead>
    <tbody></tbody>
  </table>

  <script>
    async function fetchLogs() {
      try {
        const res = await fetch('/api/logs');
        if (!res.ok) throw new Error('Failed to fetch logs');
        const logs = await res.json();
        const tbody = document.querySelector('#logsTable tbody');
        tbody.innerHTML = '';
        logs.forEach(l => {
          const tr = document.createElement('tr');
          const aiCell = (l.aiTag || l.aiSummary) ? `${l.aiTag ? `<strong>${l.aiTag}</strong>` : ''} ${l.aiSummary ? ` — ${l.aiSummary}` : ''}` : '';
          tr.innerHTML = `
            <td class="small">${escapeHtml(l.commandName)}</td>
            <td class="small">${escapeHtml(l.userId)}</td>
            <td>${escapeHtml(l.inputText || '')}</td>
            <td>${aiCell}</td>
            <td class="small">${new Date(l.timestamp).toLocaleString()}</td>
            <td class="small">${escapeHtml(l.actionTaken || 'Logged')}</td>
          `;
          tbody.appendChild(tr);
        });
        document.getElementById('loading').style.display = 'none';
        document.getElementById('logsTable').style.display = '';
      } catch (err) {
        document.getElementById('loading').textContent = 'Failed to load logs.';
        console.error(err);
      }
    }

    function escapeHtml(str) {
      if (!str) return '';
      return String(str).replace(/[&<>"]+/g, s => ({'&':'&amp;','<':'&lt;','>':'&gt;', '"':'&quot;'}[s]));
    }

    fetchLogs();
    fetchRules();
    fetchErrors();

    // Rules management
    async function fetchRules() {
      try {
        const res = await fetch('/api/config');
        if (!res.ok) throw new Error('Failed to fetch rules');
        const rules = await res.json();
        const tbody = document.querySelector('#rulesTable tbody');
        tbody.innerHTML = '';
        rules.forEach(r => {
          const tr = document.createElement('tr');
          tr.innerHTML = `
            <td class="small">${escapeHtml(r.keyword)}</td>
            <td class="small">${escapeHtml(r.tag)}</td>
            <td><button data-id="${r._id}" class="delete-rule">Delete</button></td>
          `;
          tbody.appendChild(tr);
        });
        document.querySelectorAll('.delete-rule').forEach(btn => {
          btn.addEventListener('click', async (e) => {
            const id = e.currentTarget.getAttribute('data-id');
            if (!confirm('Delete this rule?')) return;
            await deleteRule(id);
          });
        });
      } catch (err) {
        console.error(err);
      }
    }

    async function addRule() {
      const kw = document.getElementById('newKeyword').value.trim();
      const tag = document.getElementById('newTag').value.trim();
      if (!kw || !tag) {
        alert('Keyword and tag are required');
        return;
      }
      try {
        const res = await fetch('/api/config', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ keyword: kw, tag })
        });
        if (!res.ok) throw new Error('Failed to create rule');
        document.getElementById('newKeyword').value = '';
        document.getElementById('newTag').value = '';
        await fetchRules();
      } catch (err) {
        alert('Failed to add rule');
        console.error(err);
      }
    }

    async function deleteRule(id) {
      try {
        const res = await fetch(`/api/config/${encodeURIComponent(id)}`, { method: 'DELETE' });
        if (!res.ok) throw new Error('Delete failed');
        await fetchRules();
      } catch (err) {
        alert('Failed to delete rule');
        console.error(err);
      }
    }

    // Error logs
    async function fetchErrors() {
      try {
        const res = await fetch('/api/errors');
        if (!res.ok) throw new Error('Failed to fetch errors');
        const errors = await res.json();
        const tbody = document.querySelector('#errorsTable tbody');
        tbody.innerHTML = '';
        errors.forEach(e => {
          const tr = document.createElement('tr');
          tr.innerHTML = `
            <td class="small">${escapeHtml(e.source)}</td>
            <td>${escapeHtml(e.message)}</td>
            <td class="small">${new Date(e.timestamp).toLocaleString()}</td>
          `;
          tbody.appendChild(tr);
        });
      } catch (err) {
        console.error('Failed to load errors', err);
      }
    }
  </script>

  <section style="margin-top:2rem">
    <h2>Keyword → Tag Rules</h2>
    <form id="addRuleForm" onsubmit="event.preventDefault(); addRule();">
      <input id="newKeyword" placeholder="keyword" required>
      <input id="newTag" placeholder="tag (e.g. High Priority)" required>
      <button type="submit">Add Rule</button>
    </form>

    <table id="rulesTable" style="margin-top:1rem; width:100%; border-collapse:collapse">
      <thead>
        <tr><th>Keyword</th><th>Tag</th><th>Action</th></tr>
      </thead>
      <tbody></tbody>
    </table>
  </section>
  <section style="margin-top:2rem">
    <h2>Recent Error Logs</h2>
    <table id="errorsTable" style="margin-top:1rem; width:100%; border-collapse:collapse">
      <thead>
        <tr><th>Source</th><th>Message</th><th>Timestamp</th></tr>
      </thead>
      <tbody></tbody>
    </table>
  </section>
</body>
</html>
