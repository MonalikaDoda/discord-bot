<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Login</title>
  <style>
    * { box-sizing: border-box; }
    body {
      font-family: -apple-system, "Segoe UI", Arial, sans-serif;
      margin: 0;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #f5f6fa;
    }
    .container {
      max-width: 380px;
      width: 100%;
      background: #fff;
      padding: 2.5rem 2rem;
      border-radius: 12px;
      box-shadow: 0 4px 20px rgba(0,0,0,0.08);
    }
    h1 {
      margin: 0 0 1.5rem;
      font-size: 1.5rem;
      text-align: center;
    }
    .error {
      background: #fdecea;
      color: #b00020;
      padding: 0.6rem 0.8rem;
      border-radius: 6px;
      font-size: 0.9rem;
      margin-bottom: 1rem;
    }
    label {
      display: block;
      margin-top: 1rem;
      font-size: 0.85rem;
      font-weight: 600;
      color: #333;
    }
    input {
      width: 100%;
      padding: 0.6rem 0.7rem;
      margin-top: 0.35rem;
      border: 1px solid #ddd;
      border-radius: 6px;
      font-size: 0.95rem;
    }
    input:focus {
      outline: none;
      border-color: #4f6ef7;
      box-shadow: 0 0 0 3px rgba(79,110,247,0.15);
    }
    button {
      margin-top: 1.5rem;
      padding: 0.75rem;
      width: 100%;
      background: #4f6ef7;
      color: #fff;
      border: none;
      border-radius: 6px;
      font-size: 0.95rem;
      font-weight: 600;
      cursor: pointer;
      transition: background 0.15s;
    }
    button:hover { background: #3d5ce0; }

    .demo-note {
  margin-top: 1.25rem;
  padding: 0.75rem 1rem;
  background: #f0f4ff;
  border: 1px solid #d0dcf7;
  border-radius: 8px;
  font-size: 0.85rem;
  color: #444;
  text-align: center;
  line-height: 1.8;
}
    .demo-note code {
      background: #e4e9fb;
      padding: 2px 6px;
      border-radius: 4px;
      font-family: "SFMono-Regular", Consolas, monospace;
      font-size: 0.85rem;
    }
  </style>
</head>
<body>
  <div class="container">
    <h1>Admin Login</h1>
    <% if (errorMessage) { %>
      <div class="error"><%= errorMessage %></div>
    <% } %>
    <form method="POST" action="/login">
      <label for="username">Username</label>
      <input id="username" name="username" type="text" autocomplete="username" required>

      <label for="password">Password</label>
      <input id="password" name="password" type="password" autocomplete="current-password" required>

      <button type="submit">Sign In</button>
    </form>
    <div class="demo-note">
  🔑 <strong>Demo credentials</strong><br>
  Username: <code>ctcadmin</code><br>
  Password: <code>ctcadmin123</code>
</div>
  </div>
</body>
</html>